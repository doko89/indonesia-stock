# indostock environment — copy to .env and fill in real values.
# NEVER commit .env (gitignored).

# PostgreSQL password for the indostock user (docker-compose + install script)
POSTGRES_PASSWORD=change-me-long-random

# Optional overrides (defaults exist in code)
# REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=postgres://indostock:change-me-long-random@localhost:5432/indostock?sslmode=disable
# PORT=8080
